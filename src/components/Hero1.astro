---
import { StarScribble } from './icons';
---

<section id="home" class="relative pt-32 pb-10 px-4 md:px-12 max-w-7xl mx-auto overflow-hidden flex flex-col items-center">
  <div class="w-full text-center mt-8 md:mt-16 z-10 relative">
    <h1 class="text-6xl md:text-8xl lg:text-9xl font-display uppercase leading-[0.9] text-brand-cream relative inline-block">
      Software <span class="relative inline-block z-10">
        That
          {/* Yellow lightning bolt/scribble decoration */}
        <span class="absolute -top-4 -right-8 text-brand-yellow w-12 h-12 hidden md:block">
            <StarScribble className="w-12 h-12 rotate-12" />
        </span>
      </span><br />
      Ships.
    </h1>
    
    <p class="mt-8 mb-3 max-w-lg mx-auto text-gray-300 text-sm md:text-base font-medium leading-relaxed">
      We build and publish reliable software from mobile to web apps to desktop apps. Quality code, clear documentation, and products users trust.
    </p>

    <a href="/projects" class="mt-8 px-8 py-3 bg-brand-yellow text-brand-dark font-bold rounded-full uppercase text-sm hover:scale-105 transition-transform duration-300 shadow-[0_0_20px_rgba(219,232,44,0.3)]">
      Explore Our Projects
    </a>
  </div>
</section>