const { project } = Astro.props;
---

<Layout
  title={project.title + " - Icone Studio"}
  description={project.subtitle + " | " + project.description}>
<div class="bg-brand-dark min-h-screen text-brand-cream">
      {/* Hero Section */}
      <section class="relative h-[70vh] md:h-[85vh] w-full overflow-hidden">
        <img 
          src={project.heroImage} 
          alt={project.title} 
          class="w-full h-full object-cover opacity-60"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-transparent to-transparent"></div>
        <div class="absolute bottom-0 w-full p-4 md:p-12 max-w-7xl mx-auto left-1/2 -translate-x-1/2">
          <a
          href="/projects"
            class="group flex items-center gap-2 text-brand-yellow font-bold uppercase text-xs mb-8 hover:text-white transition-colors"
          >
            <span class="rotate-180"><ArrowUpRight className="w-4 h-4" /></span>
            Back to Projects
        </a>
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <h1 class="text-6xl md:text-7xl font-display uppercase leading-[0.85] max-w-4xl">
              {project.title.split(':').map((part, i) => (
                <span class={i === 1 ? "text-brand-yellow block" : "block"}>
                  {part}
                </span>
              ))}
            </h1>
          </div>
        </div>
      </section>

      {/* Project Meta Grid */}
      <section class="py-12 px-4 md:px-12 max-w-7xl mx-auto border-b border-white/10">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
          <div>
            <span class="text-gray-500 font-bold uppercase text-[10px] tracking-widest block mb-1">Client</span>
            <span class="text-xl font-display uppercase">{project.client}</span>
          </div>
          <div>
            <span class="text-gray-500 font-bold uppercase text-[10px] tracking-widest block mb-1">Industry</span>
            <span class="text-xl font-display uppercase">{project.industry}</span>
          </div>
          <div>
            <span class="text-gray-500 font-bold uppercase text-[10px] tracking-widest block mb-1">Year</span>
            <span class="text-xl font-display uppercase">{project.year}</span>
          </div>
          <div>
            <span class="text-gray-500 font-bold uppercase text-[10px] tracking-widest block mb-1">Services</span>
            <div class="flex flex-wrap gap-2 mt-1">
              {project.services.map(s => (
                <span class="bg-white/10 px-2 py-0.5 rounded text-[10px] uppercase font-bold">{s}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* About & Story */}
      <section class="py-20 px-4 md:px-12 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-5">
          <h2 class="text-4xl md:text-6xl font-display uppercase leading-none mb-6">
            The <span class="text-brand-yellow">Challenge</span>
          </h2>
          <p class="text-gray-400 text-lg leading-relaxed">
            Every project has a unique set of obstacles. For {project.client}, our primary objective was to redefine their market presence by bridging the gap between traditional reliability and modern, digital-first aesthetics.
          </p>
        </div>
        <div class="lg:col-span-7">
          <div class="bg-brand-green/30 p-8 md:p-12 rounded-[2rem] border border-white/5 backdrop-blur-sm">
            <h3 class="text-2xl font-display uppercase mb-4 text-white">Our Approach</h3>
            <p class="text-gray-300 leading-relaxed">
              {project.description}
            </p>
          </div>
        </div>
      </section>

      {/* Features Grid */}
      <section class="py-20 bg-brand-cream text-brand-dark rounded-[3rem]">
        <div class="max-w-7xl mx-auto px-4 md:px-12">
          <h2 class="text-5xl md:text-7xl font-display uppercase text-center mb-16">
            Key <span class="text-brand-green">Features</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {project.features.map((feature, i) => (
              <div  class="bg-white p-8 rounded-3xl shadow-sm border border-black/5 hover:shadow-xl transition-shadow duration-300">
                <div class="w-12 h-12 bg-brand-yellow rounded-xl flex items-center justify-center mb-6 font-display text-2xl">
                  0{i + 1}
                </div>
                <h4 class="text-2xl font-display uppercase mb-3">{feature.title}</h4>
                <p class="text-gray-600 leading-relaxed text-sm">
                  {feature.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Gallery Section */}
      <section class="py-20 px-4 md:px-12 max-w-7xl mx-auto">
        <h2 class="text-5xl md:text-7xl font-display uppercase mb-16">
          Visual <span class="text-brand-yellow">Gallery</span>
        </h2>
        <div class="columns-1 md:columns-2 gap-8 space-y-8">
          {project.gallery.map((img, i) => (
            <div class="relative group overflow-hidden rounded-[2rem] border border-white/10">
              <img 
                src={img} 
                alt={`Gallery ${i}`} 
                class="w-full h-auto object-cover transform transition-transform duration-700 group-hover:scale-105" 
              />
            </div>
          ))}
        </div>
      </section>

      {/* Footer CTA */}
      <section class="py-20 text-center border-t border-white/10">
        <span class="text-gray-500 font-bold uppercase text-xs mb-4 block">Next Up</span>
        <h2 class="text-6xl md:text-9xl font-display uppercase hover:text-brand-yellow cursor-pointer transition-colors duration-300">
          Discover More
        </h2>
        <a
         href="/projects"
          class="mt-12 inline-flex items-center gap-2 bg-brand-yellow text-brand-dark px-10 py-4 rounded-full font-bold uppercase text-sm hover:scale-105 transition-transform"
        >
          View All Projects <ArrowUpRight className="w-4 h-4" />
      </a>
      </section>
    </div>
</Layout>