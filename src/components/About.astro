---
import { Scribble } from './icons';
---

<section id="about" class="py-20 px-4 md:px-12 max-w-7xl mx-auto border-t border-white/10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        {/* Left Text */}
        <div>
          <span class="text-brand-yellow font-bold uppercase text-xs tracking-widest mb-2 block">About Us</span>
          <h2 class="text-5xl md:text-7xl font-display uppercase text-brand-cream leading-tight mb-6">
            Builders <br />
            Behind The <span class="text-gray-400">Products</span>
          </h2>
          <p class="text-gray-300 leading-relaxed mb-6">
            We're a software publishing company focused on shipping products that matter. Our team combines engineering rigor with product thinking to deliver reliable software—whether it's desktop tools, SaaS platforms, or developer-focused solutions that teams depend on every day.
          </p>
          
          <div class="mt-8 flex gap-4">
             <div class="p-4 bg-brand-green rounded-2xl border border-white/5">
                <div class="text-3xl font-display text-brand-lime mb-1">4+</div>
                <div class="text-xs uppercase font-bold text-gray-400">Years Shipping</div>
             </div>
             <div class="p-4 bg-brand-green rounded-2xl border border-white/5">
                <div class="text-3xl font-display text-brand-lime mb-1">8+</div>
                <div class="text-xs uppercase font-bold text-gray-400">Products Launched</div>
             </div>
          </div>
        </div>

        {/* Right Image Composition */}
        <div class="relative h-[500px] w-full mt-8 lg:mt-0">
           <div class="absolute top-0 right-0 w-3/4 h-3/4 rounded-[2rem] overflow-hidden border-2 border-white/10 z-10">
              <img src="https://picsum.photos/seed/team1/800/800" alt="Team meeting" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500" />
           </div>
           
           <div class="absolute bottom-0 left-0 w-2/3 h-2/3 rounded-[2rem] overflow-hidden border-2 border-brand-dark z-20 shadow-2xl">
              <img src="https://picsum.photos/seed/team2/800/800" alt="Creative process" class="w-full h-full object-cover" />
           </div>

           <div class="absolute bottom-10 right-10 z-30 text-brand-yellow animate-bounce">
              <Scribble className="w-16 h-16" />
           </div>
        </div>
      </div>
    </section>