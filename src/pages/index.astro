---
import About from '../components/About.astro';
import FAQ from '../components/FAQ';
import Foundation from '../components/Foundation.astro';
import Hero1 from '../components/Hero1.astro';
import ProjectsSection from '../components/ProjectSection';
import Testimonials from '../components/Testimonials.astro';
import Layout from '../layout/index.astro';
import { loadQuery } from '../sanity/lib/load-query';
import type { Post, Project } from '../sanity/lib/types';

const { data: projects } = await loadQuery<Project[]>({
    query: `*[_type == "project"] | order(_createdAt asc){
      name,
      slug,
      logo,
      mainImage,
      overview,
      tags[],
      status,
      publishedAt,
    }`,
  });

  const { data: posts } = await loadQuery<Post[]>({
    query: `*[_type == "post"][0..3] | order(_createdAt asc){
      title,
      slug,
      mainImage,
      overview,
      categories[]->{ title},
      publishedAt,
    }`,
  });

---


<Layout title="Test Page" description="This is a test page.">
  <Hero1 />
  <About />
  <Foundation/>
  <ProjectsSection />
  <Testimonials />
  <FAQ client:load/>
</Layout>