---
import About from '../components/About.astro';
import FAQ from '../components/FAQ';
import Foundation from '../components/Foundation.astro';
import Hero1 from '../components/Hero1.astro';
import ProjectsSection from '../components/ProjectSection';
import Testimonials from '../components/Testimonials';
import Layout from '../layout/index.astro';
import { loadQuery } from '../sanity/lib/load-query';
import type { Post, Project } from '../sanity/lib/types';

const { data: projects } = await loadQuery<Project[]>({
    query: `*[_type == "project"] | order(publishedAt desc){
      title,
      subtitle,
      slug,
      overview,
      client,
      industry,
      services[],
      mainImage,
      thumbnail,
      status,
      publishedAt,
    }`,
  });

  const { data: posts } = await loadQuery<Post[]>({
    query: `*[_type == "post"][0..3] | order(_createdAt asc){
      title,
      slug,
      mainImage,
      overview,
      categories[]->{ title},
      publishedAt,
    }`,
  });

---


<Layout title="Icone — Software Publishers" description="We build and publish software that powers businesses. From desktop apps to cloud platforms, we ship products that users trust.">
  <Hero1 />
  <About />
  <Foundation/>
  <ProjectsSection/>
  <Testimonials client:load />
  <FAQ client:load/>
</Layout>